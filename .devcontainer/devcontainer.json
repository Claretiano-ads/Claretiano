{
  "name": "Ambiente Oficial PHP 8.2 + MySQL + phpMyAdmin (ADS)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "postStartCommand": "/usr/local/bin/start-services.sh",
  "forwardPorts": [8000, 8080, 3306],
  "portsAttributes": {
    "8000": {
      "label": "Aplicação PHP (Aula 09+)",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "phpMyAdmin (Gerenciador do Banco)",
      "onAutoForward": "notify"
    },
    "3306": {
      "label": "MySQL / MariaDB Server",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "php.validate.executablePath": "/usr/local/bin/php",
        "phpserver.phpPath": "/usr/local/bin/php",
        "phpserver.ip": "0.0.0.0",
        "phpserver.port": 8000
      },
      "extensions": [
        "brapifra.phpserver",
        "xdebug.php-debug",
        "bmewburn.vscode-intelephense-client"
      ]
    }
  },
  "remoteUser": "vscode"
}
